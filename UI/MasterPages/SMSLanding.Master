<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SMSLanding.master.cs" Inherits="SMS_Gem.UI.MasterPages.SMSLanding" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - SMS Portal</title>
    <link rel="icon" type="image/svg+xml" href="<%= ResolveUrl("~/favicon.svg") %>" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="True" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- FontAwesome 6 Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Custom Glassmorphism Theme (Root Resolved) -->
    <link href="<%= ResolveUrl("~/Scripts/css/sms-glass.css") %>" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <!-- Top Navigation Bar -->
    <nav class="navbar navbar-expand-lg sticky-top px-3 glass-panel rounded-0 mb-4 border-top-0 border-start-0 border-end-0">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" href="<%= ResolveUrl("~/UI/Dashboard/LandingPage.aspx") %>">
                <i class="fa-solid fa-graduation-cap"></i>
                <span>SMS Portal</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="<%= ResolveUrl("~/UI/Dashboard/LandingPage.aspx") %>">
                            <i class="fa-solid fa-house me-1"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= ResolveUrl("~/UI/Students/StudentEntry_GEM.aspx") %>">
                            <i class="fa-solid fa-user-plus me-1"></i> New Student
                        </a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">Branch: CAP</span>
                    <a href="<%= ResolveUrl("~/UI/Auth/Login.aspx") %>" class="btn btn-sm btn-outline-danger" title="Sign Out">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Container -->
    <div class="container pb-5">
        <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
    </div>

    <!-- Core Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="<%= ResolveUrl("/Scripts/js/sms-common.js") %>"></script>


</body>
</html>

